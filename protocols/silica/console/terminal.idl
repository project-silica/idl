// The local console: text out to the screen (and the serial line), lines in
// from the keyboard.

/// A text terminal: what a shell talks to.
///
/// Output is UTF-8 text; a line ends with `\n`. The console keeps what does
/// not fit by scrolling. Input is read a line at a time, edited on the
/// console (backspace works) and echoed there, so a program sees only
/// complete lines.
protocol silica.console.Terminal version 2 {
    /// Show `text`.
    write @1 (text: string) -> ();

    /// Wait for the next complete line. An empty line with busy=false means
    /// Enter was pressed. Readers wait in turn, one call a holder: a holder
    /// whose read still waits, or a call the console has no place to keep,
    /// gets busy=true and no input was consumed.
    read_line @2 () -> (line: string, busy: bool);

    /// The size of the screen, in characters.
    size @3 () -> (columns: u32, rows: u32);
}
