// The device manager's protocol (component D15): how a program that uses
// devices (the block server, the network stack) finds the drivers.

/// The devices of the machine that have a running driver, and the way to
/// reach each driver.
///
/// A device is named by its identity: PCI segment, bus, device and function
/// as `segment << 16 | bus << 8 | device << 3 | function`.
///
/// What a caller may do is what its capability's scopes say
/// (`silica_protocols::scope`, given by its declaration): `list`, `open`
/// and `watch` the devices of a class it was given (`block`, `network`,
/// `display`, `port`, `input`, `entropy`); `list` and `watch` of every
/// class but the watchdog, and no `open`, with `list` (version 3; before,
/// seeing a class took `open` of it); `open_for`, with `delegate` and the
/// class (version 3); `restart` and `describe` any device with `control`
/// (version 2; before, any holder could open any device and restart any
/// driver).
protocol silica.device.Manager version 3 {
    /// Why a call was refused.
    enum Error : u32 {
        /// No device with that identity has a running driver.
        no_such_device = 1,
        /// The caller's capability does not allow it (version 2).
        refused = 2,
        /// The device manager has no room for what the call needs (a
        /// capability slot) (version 2; before, `no_such_device`).
        no_room = 3,
    }

    /// What a device is for.
    enum Class : u32 {
        /// Storage addressed in blocks; its driver speaks `silica.block.Device`.
        block = 1,
        /// A display; its driver speaks `silica.display.Device`.
        display = 2,
        /// A keyboard (later pointers); its driver speaks `silica.input.Device`.
        input = 3,
        /// A network interface; its driver speaks `silica.net.Device`.
        network = 4,
        /// A source of random bits; its driver speaks `silica.entropy.Device`.
        entropy = 5,
        /// A console port, a byte stream to whoever is at the other end;
        /// its driver speaks `silica.console.Port`.
        port = 6,
        /// The machine's hardware watchdog; its driver speaks
        /// `silica.watchdog.Device`. Listed and opened only by the service
        /// manager.
        watchdog = 7,
    }

    /// A device with a running driver.
    struct Device {
        /// Its identity.
        id: u32,
        /// What it is for, and so which protocol its driver speaks.
        class: Class,
        /// The name of its driver.
        driver: string,
    }

    /// The devices of class `class` that have a running driver (none for a
    /// class the caller was not given), from the `from`th on, as many as
    /// fit a message; `next` is where the next part starts, 0 when there are
    /// no more (version 2).
    list @1 (class: Class, from: u32) -> (devices: array<Device>, next: u32);

    /// An endpoint to the driver of the device `id`, speaking the protocol
    /// of the device's class. It stops working when the driver ends; a
    /// driver that is started again is reached by a new `open`. `gone`, if
    /// given, is signalled when this driver ends (however it ends), so a
    /// client waiting for its device hears of it at once: the device
    /// manager keeps the capability until then, one for each notification
    /// given (the same one given again replaces it), at most 16 for one
    /// holder and 64 for one caller, `no_room` past them (those whose
    /// notification is gone do not count) (version 3; before, one for each
    /// caller and device). Each capability it returns has a badge of its
    /// own, never given before by that driver while it runs, that names the
    /// consumer it is charged to (the caller; `silica_protocols::driver_badge`
    /// has the layout): a driver charges what it keeps for each capability
    /// to that consumer (version 3).
    open @2 (id: u32, gone: option<cap<Notification>>) -> (driver: cap<Endpoint>) error Error;

    /// End the driver of the device `id` at once, as if it had failed, and
    /// start it again: what the owner does to a driver that misbehaves, and
    /// how its clients' recovery is tested. Its clients' `gone` is
    /// signalled.
    restart @3 (id: u32) -> () error Error;

    /// What the driver of the device `id` holds and what its threads do,
    /// as `silica.system.Manager`'s `describe` says it of a service: one
    /// line per capability and per thread, the first naming the driver as
    /// `<driver>@<device>`. A long answer comes in parts: `text` holds the
    /// lines from line `from`, and `next` is where the next part starts (0:
    /// there is none).
    describe @4 (id: u32, from: u32) -> (text: string, next: u32) error Error;

    /// Signal `changed` whenever a device of class `class` gains a running
    /// driver or loses one: it arrived or was taken out, or its driver
    /// ended or started again. A client that waits for a device watches
    /// first and then calls `list`, and calls `list` again each time
    /// `changed` is signalled: a change between the two is never missed,
    /// and a client with nothing to wait for is not woken. The device
    /// manager keeps the capability until signalling it fails, one for each
    /// caller and class (a later `watch` replaces it); a class the caller
    /// was not given is not watched.
    watch @5 (class: Class, changed: cap<Notification>) -> ();

    /// As `open`, charged at the driver to `client` (a number of the
    /// caller's own, at most 65535; `refused` past it) within the caller's
    /// share: for a service that opens devices for its own clients (the
    /// block server, a partition for each), so it divides what it may keep
    /// in a driver among them and no client of it fills what another needs,
    /// while it can make no share of its own nor charge another program's.
    /// Needs `delegate`, which the service manager gives only the provider
    /// of `silica.block.Partitions`, and the device's class (version 3).
    open_for @6 (id: u32, client: u32, gone: option<cap<Notification>>) -> (driver: cap<Endpoint>) error Error;
}
