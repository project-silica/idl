// The service manager's protocol (components D02, D16): what the owner, the
// power button and a remote management session use to look at and steer
// the system.

/// The system's services, and the machine's power.
///
/// Provided by the service manager (the root task). Every running program
/// of the system is one of its services or a child of one; a service is
/// named as its declaration names it (the boot archive's services list).
///
/// What a caller may do is what its capability's scopes say
/// (`silica_protocols::scope`, given by its declaration): `observe`
/// (`list`, `describe`, `memory`), `control` (`start`, `stop`, `restart`),
/// `update` (`stage`, `update`, `revert`), `power` (`shutdown`) and `logs`
/// (`add_log`). Anything else is `refused`; `list` and `memory` answer a
/// caller without `observe` with nothing (version 4; before, every holder
/// could do everything, the device manager included).
protocol silica.system.Manager version 4 {
    /// Why a call was refused.
    enum Error : u32 {
        /// No service has that name.
        no_such_service = 1,
        /// The service cannot do that: it is not running (`stop`,
        /// `restart`), or it is one the system cannot run without (`stop`
        /// of the device manager).
        refused = 2,
        /// The caller already gave a log of that name, and its ring is
        /// still there (`add_log`; one whose ring is gone is replaced).
        exists = 3,
        /// Answered by `log_ring` alone, which version 2 retired.
        no_such_log = 4,
        /// The bytes given are not a program this machine runs (`update`,
        /// version 3): not an ELF image for its processor, or one whose
        /// parts do not fit where it says they go.
        not_a_program = 5,
        /// Past the largest program the service manager takes (16 MiB), past
        /// what the caller staged, or more staged by all callers at once
        /// than it keeps (32 MiB) (`stage`, `update`; version 3).
        too_large = 6,
    }

    /// What a service is doing.
    enum State : u32 {
        /// It runs.
        running = 1,
        /// It is not running: it ended, was stopped, or only runs as a check.
        stopped = 2,
        /// It failed more often than it is started again.
        failed = 3,
    }

    /// A service.
    struct Service {
        name: string,
        state: State,
        /// How many times it failed since the system started.
        failures: u32,
        /// The protocol it provides, or the empty string.
        provides: string,
        /// The BLAKE2s-256 hash of the program it runs, or is started on
        /// next (version 3): what an owner compares with the program they
        /// meant to run.
        program: bytes,
        /// That program came by `update` (version 3), not with the boot
        /// archive.
        updated: bool,
    }

    /// The declared services and what each is doing, from the `from`th on,
    /// as many as fit a message; `next` is where the next part starts, 0
    /// when there are no more (version 4; before, every service in one
    /// message, which failed for every caller past some 40 of them).
    list @1 (from: u32) -> (services: array<Service>, next: u32);

    /// Stop the service `name` now (its program ends at once, as if it had
    /// failed, but it is not started again) or start it again.
    stop @2 (name: string) -> () error Error;
    start @3 (name: string) -> () error Error;

    /// What the running service `name` holds and what its threads are
    /// doing, as lines of text: `process <name>: <n> capabilities, <m>
    /// threads`, then a line per capability (`slot <i>: <type> rights
    /// <rwxg> bits <b> object <id> badge <b> depth <d>`) and per thread
    /// (`thread <id>: <state> on processor <c>, at <ip>, waiting on <id>`);
    /// an object's id is the same in every line about it. A long answer
    /// comes in parts: `text` holds the lines from line `from`, and `next`
    /// is where the next part starts (0: there is none).
    describe @5 (name: string, from: u32) -> (text: string, next: u32) error Error;
    /// Stop every service, in the reverse of the order they started, then
    /// turn the machine off (`reboot`: reset it). Answered only if it
    /// cannot be done.
    shutdown @4 (reboot: bool) -> () error Error;
    /// End the running service `name` at once, as if it had failed (its
    /// memory and capabilities taken away, its clients' calls in progress
    /// answered `peer_gone`), and start it again, whatever its declaration
    /// says: what the owner does to a service that misbehaves, and how its
    /// clients' recovery is tested. Not counted among its failures. Its
    /// clients' capabilities go on working: calls made while it restarts
    /// wait for the new instance. A machine service (the device manager)
    /// is given its device memory again, emptied of what it made of it;
    /// its drivers, its children, end with it and are started again by
    /// the new one. `refused` for a service that is not running.
    restart @8 (name: string) -> () error Error;
    /// The machine's memory as the service manager has it: `free`, the
    /// bytes it can still give a program it starts (the empty blocks of
    /// programs that ended count, so it comes back as they end), and
    /// `held`, the bytes the running services were given. A service
    /// restarted any number of times leaves `free` as it found it.
    memory @9 () -> (free: u64, held: u64);

    /// Give a program the calling service runs itself (a driver the device
    /// manager starts) a log of its own, kept and read like a service's:
    /// `ring` is a frame of 2^14 bytes the caller made (`silica_rt::log`
    /// lays it out), and `wake` what its writer signals, the two a
    /// program is started with (`silica_proc::Program::log`). The log
    /// shows its text as the source `<caller>/<name>`, where `<caller>` is
    /// the calling service's name, so no service can write as another. The
    /// caller keeps both for the next program in the same place (a driver
    /// started again writes on where the last one stopped). At most 64
    /// logs are given in all; past that, and with no log service, the
    /// answer is `refused`.
    add_log @6 (name: string, ring: cap<Frame>) -> (wake: cap<Notification>) error Error;

    /// Write `data` at byte `at` of the program the caller is sending (at
    /// most 3,900 bytes a call): the service manager keeps one for each
    /// caller, in its own memory, until `update` takes it or the caller
    /// starts another at byte 0. A program comes in pieces rather than in a
    /// frame the caller lends, so the service manager never reads memory
    /// that its owner can take back while it reads.
    stage @10 (at: u64, data: bytes) -> () error Error;
    /// Run the service `name` from now on on the first `length` bytes the
    /// caller staged (an ELF image for this machine), in place of the
    /// program it runs: what installs a new version of a service while the
    /// system runs. A running service is ended and started on the new
    /// program, as by `restart`; one that is not running starts on it when
    /// it is next started. `not_a_program` for bytes that are not one, and
    /// nothing changes.
    ///
    /// An update is undone by itself when it does not work. A new program
    /// that cannot be started is answered `refused`, and the service runs
    /// its last program again. One that fails (faults, or ends with a
    /// status other than 0) within 10 s of starting is replaced by the
    /// program the service ran before, which is started again, `list` shows
    /// it, and the log says why. The boot archive is not changed: the
    /// machine boots with the archive's program until the system has
    /// storage to keep an update in (M5). Each `update` takes the staged
    /// program, whatever its answer.
    update @11 (name: string, length: u64) -> () error Error;
    /// Run the service `name` on its program in the boot archive again,
    /// undoing every `update` of it, and restart it on that if it runs.
    revert @12 (name: string) -> () error Error;

    /// `log_ring`, by which the log service asked for the rings given with
    /// `add_log`, retired in version 2: the service manager waits for the
    /// log service's flushes, so the log service must not wait for it. It
    /// finds the rings in its CapSpace and their names in a directory the
    /// service manager writes (`silica_rt::log::directory`).
    reserved @7;
}
